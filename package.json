{
  "name": "ffc-ex-slopestohope-org",
  "version": "0.1.0",
  "private": true,
  "description": "Static clone of slopestohope.org, served from GitHub Pages via a Next.js static export.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx serve -s out -l 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:clone": "node tools/verify-no-legacy.mjs",
    "verify:paths": "node tools/lib/resolve-within.mjs",
    "audit:high": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "^16.2.11",
    "postcss": "^8.5.22",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "playwright": "^1.62.0",
    "prettier": "^3.9.0",
    "typescript": "^5"
  },
  "overrides": {
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1",
    "picomatch": ">=4.0.4",
    "tmp": "^0.2.6",
    "sharp": "^0.35.3",
    "postcss": "$postcss"
  }
}
